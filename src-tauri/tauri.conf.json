{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataCore",
  "version": "0.1.0",
  "identifier": "com.datacore.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DataCore",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": null,
        "windowPosition": { "x": 400, "y": 400 },
        "windowSize": { "width": 600, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 420, "y": 170 }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/chanchai9666/DataCore/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCRjIxQ0YyOEEwQzc2RTgKUldTdWJ0bGVEZW1vS2V5Rm9yVmVyaWZpY2F0aW9uT25seUF1dG9VcGRhdGVyCg=="
    }
  }
}
